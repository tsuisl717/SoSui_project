# =============================================================================
# SoSui frontend — public env (consumed at build time / on the client)
# Run `cd move && npm run publish` to populate the SUI_* values automatically.
# =============================================================================

NEXT_PUBLIC_SUI_NETWORK=devnet
NEXT_PUBLIC_SUI_RPC=https://fullnode.devnet.sui.io:443
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_CONFIG_ID=
NEXT_PUBLIC_SUI_TREASURY=

# ---------- blob storage backend (server only, pick ONE) ----------
# 1. Pinata — real IPFS, works across deployments. Recommended for production.
#    Get free JWT at https://app.pinata.cloud
PINATA_JWT=
# Optional dedicated gateway. Defaults to https://gateway.pinata.cloud
PINATA_GATEWAY=

# 2. Filesystem — persists across restarts on a single-VPS deployment.
#    Set to an absolute directory the server can write.
BLOB_DIR=

# 3. (default if both above are empty) in-memory map. Dev/demo only —
#    blobs vanish on server restart and don't cross processes.
