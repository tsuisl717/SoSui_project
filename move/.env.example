# =============================================================================
# sosui_media — Sui deploy config
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# Deployer private key — Sui bech32 format, starting with "suiprivkey1...".
# Get this by running:
#   sui keytool export <your-address>
# It will print { "exportedPrivateKey": "suiprivkey1abc..." } — paste that here.
DEPLOYER_PRIVATE_KEY=

# Target network: mainnet | testnet | devnet | localnet
NETWORK=testnet

# Optional custom RPC URL. Leave blank to use the default fullnode for NETWORK.
RPC_URL=

# Treasury private key — only needed if the on-chain Config.treasury is a
# DIFFERENT address from the deployer (after you've rotated via
# `npm run update-treasury`). Used exclusively by `npm run withdraw`.
# Same format as DEPLOYER_PRIVATE_KEY. Leave blank if treasury == deployer.
TREASURY_PRIVATE_KEY=
